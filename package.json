  "description": "Lovense integration for Mahjong Soul: toy reactions to game events, plus optional Twitch viewer triggers via mahjong-soul-twitch.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
