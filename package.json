{
  "name": "mahjong-soul-lovense",
  "version": "2.3.0",
  "description": "Lovense integration for Mahjong Soul (Steam client): reads the game from the screen and makes your toy react, plus optional Twitch viewer triggers.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build:host": "dotnet build host/MahjongSoulHost.csproj -c Release -nologo -v q",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/screen.test.mjs test/triggers.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exeName": "MahjongSoul-Lovense",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrooklynVRC/Mahjong-Soul-Lovense-Integration"
  },
  "app": {
    "title": "Mahjong Soul × Lovense",
    "dataFolder": "MahjongSoulLovense",
    "accent": "#ff5c9a",
    "letter": "L"
  }
}
